# Optional overrides. `docker compose up` works without a .env file.
# Copy to .env and uncomment what you need.

# ---- Demo data (see README "Demo data") ----------------------------------
# COMPOSE_PROFILES=demo
# AMCONNECT_SEED=true
# AMCONNECT_HARVEST=true

# ---- Admin accounts --------------------------------------------------------
# CKAN_SYSADMIN_NAME=admin
# CKAN_SYSADMIN_PASSWORD=admin12345
# CKAN_SYSADMIN_EMAIL=admin@example.org
# GEOSERVER_ADMIN_USER=admin
# GEOSERVER_ADMIN_PASSWORD=geoserver
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

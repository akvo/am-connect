# Optional overrides. `docker compose up` works without a .env file.
# Copy to .env and uncomment what you need.

# ---- Demo data (see README "Demo data") ----------------------------------
# COMPOSE_PROFILES=demo
# AMCONNECT_SEED=true
# AMCONNECT_HARVEST=true

# ---- Users and login (see README "Users and access") ------------------------
# SUPERADMIN_EMAIL=admin@example.org
# SUPERADMIN_PASSWORD=admin12345
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_FROM=no-reply@amconnect.local
# client secrets shared between Keycloak and the apps
# PLATFORM_CLIENT_SECRET=dev-platform-secret
# PLATFORM_ADMIN_CLIENT_SECRET=dev-platform-admin-secret
# CKAN_CLIENT_SECRET=dev-ckan-secret
# AUTH_SECRET=dev-auth-secret-change-me

# ---- Admin accounts --------------------------------------------------------
# CKAN_SYSADMIN_NAME=admin
# CKAN_SYSADMIN_PASSWORD=admin12345
# CKAN_SYSADMIN_EMAIL=ckan-admin@example.org
# GEOSERVER_ADMIN_USER=admin
# GEOSERVER_ADMIN_PASSWORD=geoserver
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
